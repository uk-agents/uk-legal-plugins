      "skill": "find-member-contribution",
      "plugin": "regulatory-legal-uk",
      "prompt": "What did Baroness Thornton say about the Online Safety Act during the Lords report stage debates?",
      "assertions": {
        "skill_triggered": "find-member-contribution",
